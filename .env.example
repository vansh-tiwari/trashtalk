# GEMINI_API_KEY: Optional server-only API key for Google Gemini roast generation.
# When omitted, TrashTalk automatically falls back to the deterministic local roaster ($0 spend).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NEXT_PUBLIC_APP_URL: Canonical public origin used for OpenGraph cards, sitemaps, and share links.
NEXT_PUBLIC_APP_URL="https://trashtalk.vercel.app"

# APP_URL: Internal/Cloud Run service URL injected by the hosting environment.
APP_URL="https://trashtalk.vercel.app"
